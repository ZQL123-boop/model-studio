# ---------------------------------------------------------------- Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------- Node
web/node_modules/
web/dist/
# Node 编译缓存：NODE_COMPILE_CACHE=0 会被当成目录名 "0"，实测生成过 12M 垃圾
web/0/

# ---------------------------------------------------------------- 模型权重（GB 级，不进仓库）
models/
training/adapters*/
*.safetensors
*.npz

# ---------------------------------------------------------------- 密钥 / 凭证
# .env 里有 MODEL_STUDIO_TOKEN（界面访问口令），绝不能进公开仓库
.env
.env.*
!.env.example

# ---------------------------------------------------------------- 运行时 / 隐私
# data/ 里有门禁密码哈希、lock 密码哈希、访问 token、聊天历史 —— 绝对不能提交
data/
logs/
*.log

# ---------------------------------------------------------------- 本机备份
*.bak
*.bak[0-9]*

# ---------------------------------------------------------------- macOS
.DS_Store
